NODE_ENV=development
PORT=3333
HOST=0.0.0.0
CORS_ORIGIN=*
RATE_LIMIT_MAX=120
ENABLE_SIMULATION_PARAMS=false
FORECAST_PROVIDER=open-meteo
HTTP_TIMEOUT_MS=8000
CACHE_TTL_FORECAST_SECONDS=900
CACHE_TTL_INMET_SECONDS=600
CACHE_TTL_CGE_SECONDS=300
CACHE_TTL_HISTORICAL_SECONDS=86400
CACHE_TTL_OVERPASS_SECONDS=86400
CACHE_TTL_GEOSAMPA_SECONDS=86400
CACHE_TTL_GEOCODE_SECONDS=86400
OVERPASS_URLS=https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
NOMINATIM_USER_AGENT=ooh-alerta-alagamentos/0.2 (+https://github.com/lanjosdev/ooh-alerta-alagamentos)
